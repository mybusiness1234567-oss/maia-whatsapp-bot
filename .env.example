# ============================================
# MAIA WhatsApp Bot — Environment Variables
# ============================================
# Kopiere diese Datei zu .env und fülle die Werte aus.

# --- Meta / WhatsApp Cloud API ---
WHATSAPP_TOKEN=           # Permanenter System-User-Token aus Meta Business
WHATSAPP_PHONE_ID=        # Phone Number ID aus dem WhatsApp Business Dashboard
WHATSAPP_VERIFY_TOKEN=    # Beliebiger String, den du beim Webhook-Setup angibst
META_APP_SECRET=          # App Secret aus den Meta App Settings (für Signatur-Check)

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=        # Dein Claude API Key (sk-ant-...)

# --- Server ---
PORT=3000
NODE_ENV=production
